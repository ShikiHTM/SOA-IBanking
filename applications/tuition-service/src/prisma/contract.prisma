// use prisma-8

model Student {
    id  String  @id
    name    String
    tuitions    TuitionInvoice[]
    created_at DateTime @default(now())
    updated_at temporal.updatedAt()
    @@map("student")
}

enum TuitionStatus {
    @@type("pg/text@1")
    PENDING = "pending"
    OVERDUE = "overdue"
    PAID    = "paid"
}

model TuitionInvoice {
    id  String  @id @default(uuid())
    student  Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
    student_id  String
    amount  Float
    status TuitionStatus @default(PENDING)
    created_at DateTime @default(now())
    updated_at temporal.updatedAt()
    @@map("tuition_invoice")
}
